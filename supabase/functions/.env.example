# SERVER ONLY: configure with the Edge Functions secret store; never prefix VITE_.
# No real values belong in this example or in committed files.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are runtime-provided
# in hosted Supabase Edge Functions. Keep the service-role key server-only.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
APP_URL=
# Per-client OAuth access/refresh tokens belong in server-restricted storage,
# not global environment variables. DB permission changes require separate approval.
